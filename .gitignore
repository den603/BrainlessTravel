# ===================== 后端 SpringBoot 相关忽略 =====================
# Java编译打包产物
backend/target/
backend/!.gitignore
backend/!.gitattributes

# IDE 缓存配置
backend/.idea/
backend/*.iml
backend/.vscode/

# 日志文件
backend/logs/
backend/*.log
backend/heapdump*.hprof

# Maven 临时文件
backend/.mvn/wrapper/maven-wrapper.jar

# 【核心】屏蔽带密码密钥的本地开发配置（绝对不上传GitHub）
# 微服务化后，travel-gateway / travel-user-service / travel-ai-service
# 三个服务各有自己的 application.yml（含 MySQL/Redis/JWT/星火密钥），全部排除。
# 注意：application-template.yml 是配置模板，必须保留并提交。
**/src/main/resources/application.yml
**/src/main/resources/application.properties
**/src/main/resources/application-local.yml

# ===================== UniApp 微信小程序前端相关忽略 =====================
# 前端依赖包（体积超大，使用者本地npm install生成）
uniapp-front/node_modules/
uniapp-front/uni_modules/
# 编译打包输出目录
uniapp-front/unpackage/
uniapp-front/dist/

# 编辑器缓存
uniapp-front/.vscode/
uniapp-front/.idea/

# 日志、临时文件
uniapp-front/*.log
uniapp-front/.DS_Store

# ===================== Windows / Mac 系统冗余垃圾文件 =====================
.DS_Store
Thumbs.db
desktop.ini

# ===================== 本地交付文档（不上传 GitHub） =====================
/docs/LANGCHAIN_RAG_DEV_REQUIREMENTS.md
/docs/MIGRATION_DELIVERY.md
